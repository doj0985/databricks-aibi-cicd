{
  "datasets": [
    {
      "displayName": "defects",
      "name": "770a63a5",
      "parameters": [
        {
          "dataType": "STRING",
          "defaultSelection": {},
          "displayName": "parameter",
          "keyword": "parameter"
        }
      ],
      "queryLines": [
        "WITH defects as (\n",
        "    SELECT *, \"apex\" as company\n",
        "    FROM aibi_embedding_doyoung.data.defects_apex\n",
        "    UNION\n",
        "    SELECT *, \"synergy\" as company\n",
        "    FROM aibi_embedding_doyoung.data.defects_synergy\n",
        "),\n",
        "orderdetails as (\n",
        "    SELECT *\n",
        "    FROM aibi_embedding_doyoung.data.orderdetails_apex\n",
        "    UNION\n",
        "    SELECT *\n",
        "    FROM aibi_embedding_doyoung.data.orderdetails_synergy\n",
        "),\n",
        "orders as (\n",
        "    SELECT *\n",
        "    FROM aibi_embedding_doyoung.data.orders_apex\n",
        "    UNION\n",
        "    SELECT *\n",
        "    FROM aibi_embedding_doyoung.data.orders_synergy\n",
        "),\n",
        "customer as (\n",
        "    SELECT customerid, customername, contactemail, industry\n",
        "    FROM aibi_embedding_doyoung.data.customers_apex\n",
        "    UNION\n",
        "    SELECT *\n",
        "    FROM aibi_embedding_doyoung.data.customers_synergy\n",
        ")\n",
        "SELECT *\n",
        "FROM defects d join orderdetails od on d.orderdetailid = od.orderdetailid \n",
        "    join orders o on od.orderid = o.orderid\n",
        "    join customer c on o.customerid = c.customerid \n",
        "WHERE company = LOWER(__aibi_external_value) :parameter "
      ]
    }
  ],
